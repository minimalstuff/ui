{
	"name": "@minimalstuff/ui",
	"version": "4.3.2",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/minimalstuff/ui.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/minimalstuff-ui.js",
	"module": "./dist/minimalstuff-ui.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#components/*": "./src/components/*.js",
		"#hooks/*": "./src/hooks/*.js",
		"#lib/*": "./src/lib/*.js",
		"#types/*": "./src/types/*.js",
		"#stores/*": "./src/stores/*.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/minimalstuff-ui.js",
			"default": "./dist/minimalstuff-ui.js"
		},
		"./style.css": "./dist/minimalstuff-ui.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "tsc -b && VITE_BUILD_LIB=1 vite build && node scripts/verify_bundled_types.ts",
		"lint": "oxlint . --deny-warnings",
		"test": "vitest run --config vitest.ci.config.ts",
		"test:stories": "vitest run",
		"preview": "vite preview --outDir storybook-static --port 6006 --host 0.0.0.0",
		"format": "oxfmt && oxlint --fix",
		"storybook": "storybook dev -p 6006 ",
		"build-storybook": "storybook build",
		"release": "release-it",
		"ci": "storybook dev -p 6006 --ci",
		"lint:fix": "oxlint . --fix --fix-suggestions",
		"format:check": "oxfmt . --check",
		"typecheck": "tsc --build --force",
		"knip": "knip",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip && node scripts/verify_media_variants.ts"
	},
	"dependencies": {
		"@floating-ui/react-dom": "^2.1.9",
		"clsx": "^2.1.1",
		"react-call": "^2.0.2",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@microsoft/api-extractor": "^7.60.0",
		"@minimalstuff/tooling": "^0.7.0",
		"@release-it/conventional-changelog": "^12.0.2",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-onboarding": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/typescript6": "^6.0.2",
		"@unocss/preset-icons": "^66.12.0",
		"@unocss/preset-web-fonts": "^66.12.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"happy-dom": "^21.0.4",
		"knip": "^6.43.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"playwright": "^1.64.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"release-it": "^21.1.1",
		"storybook": "^10.6.5",
		"typescript": "~7.0.2",
		"unocss": "^66.12.0",
		"vite": "8.3.5",
		"vite-plugin-dts": "^5.1.2",
		"vitest": "^5.0.5",
		"vitest-axe": "^0.1.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"packageManager": "pnpm@12.16.1"
}
