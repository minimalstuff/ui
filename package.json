{
	"name": "@minimalstuff/ui",
	"version": "2.1.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/minimalstuff/ui.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/minimalstuff-ui.js",
	"module": "./dist/minimalstuff-ui.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#components/*": "./src/components/*.js",
		"#hooks/*": "./src/hooks/*.js",
		"#lib/*": "./src/lib/*.js",
		"#types/*": "./src/types/*.js",
		"#stores/*": "./src/stores/*.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/minimalstuff-ui.js",
			"default": "./dist/minimalstuff-ui.js"
		},
		"./style.css": "./dist/minimalstuff-ui.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "tsc -b && VITE_BUILD_LIB=1 vite build",
		"lint": "oxlint .",
		"test": "vitest run --config vitest.ci.config.ts",
		"test:stories": "vitest run",
		"preview": "vite preview --outDir storybook-static --port 6006 --host 0.0.0.0",
		"format": "pnpm lint:fix; oxfmt .",
		"storybook": "storybook dev -p 6006 ",
		"build-storybook": "storybook build",
		"release": "release-it",
		"ci": "storybook dev -p 6006 --ci",
		"lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously",
		"format:check": "oxfmt . --check",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip"
	},
	"dependencies": {
		"@floating-ui/react-dom": "^2.1.9",
		"clsx": "^2.1.1",
		"react-call": "^2.0.2",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.0",
		"@microsoft/api-extractor": "^7.58.12",
		"@minimalstuff/tooling": "^0.6.0",
		"@release-it/conventional-changelog": "^12.0.0",
		"@storybook/addon-a11y": "^10.5.7",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-onboarding": "^10.5.7",
		"@storybook/addon-vitest": "^10.5.7",
		"@storybook/react-vite": "^10.5.7",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@unocss/preset-icons": "^66.7.5",
		"@unocss/preset-web-fonts": "^66.7.5",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"happy-dom": "^20.11.2",
		"knip": "^6.32.2",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"playwright": "^1.62.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"release-it": "^21.0.2",
		"storybook": "^10.5.7",
		"typescript": "~6.0.3",
		"unocss": "^66.7.5",
		"vite": "8.2.1",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"volta": {
		"node": "24.14.1"
	}
}
