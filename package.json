{
	"name": "@minimalstuff/ui",
	"version": "3.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/minimalstuff/ui.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/minimalstuff-ui.js",
	"module": "./dist/minimalstuff-ui.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#components/*": "./src/components/*.js",
		"#hooks/*": "./src/hooks/*.js",
		"#lib/*": "./src/lib/*.js",
		"#types/*": "./src/types/*.js",
		"#stores/*": "./src/stores/*.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/minimalstuff-ui.js",
			"default": "./dist/minimalstuff-ui.js"
		},
		"./style.css": "./dist/minimalstuff-ui.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "tsc -b && VITE_BUILD_LIB=1 vite build && node scripts/verify_bundled_types.ts",
		"lint": "oxlint . --deny-warnings",
		"test": "vitest run --config vitest.ci.config.ts",
		"test:stories": "vitest run",
		"preview": "vite preview --outDir storybook-static --port 6006 --host 0.0.0.0",
		"format": "pnpm lint:fix; oxfmt .",
		"storybook": "storybook dev -p 6006 ",
		"build-storybook": "storybook build",
		"release": "release-it",
		"ci": "storybook dev -p 6006 --ci",
		"lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously",
		"format:check": "oxfmt . --check",
		"typecheck": "tsc --build --force",
		"knip": "knip",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip"
	},
	"dependencies": {
		"@floating-ui/react-dom": "^2.1.9",
		"clsx": "^2.1.1",
		"react-call": "^2.0.2",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@microsoft/api-extractor": "^7.59.1",
		"@minimalstuff/tooling": "^0.6.0",
		"@release-it/conventional-changelog": "^12.0.2",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-onboarding": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@unocss/preset-icons": "^66.10.5",
		"@unocss/preset-web-fonts": "^66.10.5",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"happy-dom": "^20.14.5",
		"knip": "^6.36.0",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2001",
		"playwright": "^1.63.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"release-it": "^21.0.3",
		"storybook": "^10.6.0",
		"typescript": "~6.0.3",
		"unocss": "^66.10.5",
		"vite": "8.3.0",
		"vite-plugin-dts": "^5.1.0",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"volta": {
		"node": "24.14.1"
	},
	"packageManager": "pnpm@11.0.9"
}
